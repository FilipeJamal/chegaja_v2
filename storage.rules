rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function hasVerifiedPhone() {
      return signedIn()
        && request.auth.token != null
        && request.auth.token.keys().hasAny(['phone_number'])
        && request.auth.token['phone_number'] is string
        && request.auth.token['phone_number'].size() >= 8;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token != null
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token['admin'] == true;
    }

    function canUploadKyc() {
      return signedIn()
        && request.auth.token != null
        && request.auth.token.keys().hasAny(['kyc_upload_enabled'])
        && request.auth.token['kyc_upload_enabled'] == true;
    }

    function activePilotParticipantData() {
      return signedIn() && firestore.exists(
          /databases/(default)/documents/pilot_participants/$(uid())
        )
        ? firestore.get(
            /databases/(default)/documents/pilot_participants/$(uid())
          ).data
        : null;
    }

    function isActivePilotParticipantForRole(role) {
      let participant = activePilotParticipantData();
      return hasVerifiedPhone()
        && participant is map
        && participant.keys().hasAny(['status'])
        && participant['status'] == 'active'
        && participant.keys().hasAny(['roles'])
        && participant['roles'] is list
        && participant['roles'].hasAny([role]);
    }

    function isActivePilotParticipant() {
      return isActivePilotParticipantForRole('cliente')
        || isActivePilotParticipantForRole('prestador');
    }

    function hasActiveKycUploadGrant(prestadorId, submissionId) {
      let grantPath = /databases/(default)/documents/kyc_upload_grants/$(prestadorId);
      return firestore.exists(grantPath)
        && firestore.get(grantPath).data['submissionId'] == submissionId
        && firestore.get(grantPath).data['expiresAt'] > request.time;
    }

    function clienteIdFromData(data) {
      return data is map
        ? (data.keys().hasAny(['clienteId'])
          ? data['clienteId']
          : (data.keys().hasAny(['clientId']) ? data['clientId'] : null))
        : null;
    }

    function pedidoPath(pedidoId) {
      return /databases/(default)/documents/pedidos/$(pedidoId);
    }

    function pedidoExists(pedidoId) {
      return firestore.exists(pedidoPath(pedidoId));
    }

    function providerHasFullPedidoAccess(pedido) {
      return signedIn()
        && pedido is map
        && pedido.keys().hasAll([
          'prestadorId',
          'providerAccessGranted',
          'providerAccessGrantedTo',
          'providerAccessGrantedAt'
        ])
        && pedido['prestadorId'] == uid()
        && pedido['providerAccessGranted'] == true
        && pedido['providerAccessGrantedTo'] == uid()
        && pedido['providerAccessGrantedAt'] is timestamp
        && pedido['providerAccessGrantedAt'] > timestamp.date(1970, 1, 1)
        && pedidoAllowsProviderHistory(pedido);
    }

    function pedidoAllowsProviderHistory(pedido) {
      let hasStatus = pedido is map && pedido.keys().hasAny(['status']);
      let hasEstado = pedido is map && pedido.keys().hasAny(['estado']);
      let status = hasStatus ? pedido['status'] : null;
      let estado = hasEstado ? pedido['estado'] : null;
      let lifecycle = status is string ? status : estado;
      return lifecycle in [
          'aceito',
          'em_andamento',
          'aguarda_confirmacao_valor',
          'concluido'
        ]
        && (!hasStatus || !hasEstado || status == estado);
    }

    function pedidoAllowsParticipantWrites(pedidoId) {
      let pedido = firestore.get(pedidoPath(pedidoId)).data;
      let hasStatus = pedido is map && pedido.keys().hasAny(['status']);
      let hasEstado = pedido is map && pedido.keys().hasAny(['estado']);
      let status = hasStatus ? pedido['status'] : null;
      let estado = hasEstado ? pedido['estado'] : null;
      let lifecycle = status is string ? status : estado;
      return lifecycle in [
          'criado',
          'aguarda_resposta_prestador',
          'aguarda_resposta_cliente',
          'aceito',
          'em_andamento',
          'aguarda_confirmacao_valor'
        ]
        && (!hasStatus || !hasEstado || status == estado);
    }

    function isPedidoParticipant(pedidoId) {
      let pedido = firestore.get(pedidoPath(pedidoId)).data;
      return hasVerifiedPhone()
        && pedidoExists(pedidoId)
        && (
          (clienteIdFromData(pedido) == uid()
            && isActivePilotParticipantForRole('cliente'))
          || (
            providerHasFullPedidoAccess(pedido)
            && isActivePilotParticipantForRole('prestador')
          )
        );
    }

    function isSupportedAttachmentType(contentType) {
      return contentType is string
        && (
          contentType.matches('image/.*')
          || contentType == 'application/pdf'
          || contentType == 'text/plain'
        );
    }

    function isSupportedImageType(contentType) {
      return contentType is string && contentType.matches('image/.*');
    }

    function isSupportedAudioType(contentType) {
      return contentType is string && contentType.matches('audio/.*');
    }

    function validUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && isSupportedAttachmentType(request.resource.contentType);
    }

    function validImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && isSupportedImageType(request.resource.contentType);
    }

    function validAudioUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && isSupportedAudioType(request.resource.contentType);
    }

    match /pedidos/{pedidoId}/anexos/{fileName} {
      allow read: if isPedidoParticipant(pedidoId) || isAdmin();
      allow create: if (
          isAdmin()
          || (resource == null
            && isPedidoParticipant(pedidoId)
            && pedidoAllowsParticipantWrites(pedidoId))
        )
        && validUpload(20 * 1024 * 1024);
      allow update: if isAdmin() && validUpload(20 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /temp/{userId}/anexos/{fileName} {
      allow read: if isAdmin()
        || (uid() == userId && isActivePilotParticipantForRole('cliente'));
      allow create, update: if (
          isAdmin()
          || (uid() == userId && isActivePilotParticipantForRole('cliente'))
        )
        && validUpload(20 * 1024 * 1024);
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    match /chats/{pedidoId}/images/{fileName} {
      allow read: if isPedidoParticipant(pedidoId) || isAdmin();
      allow create: if (
          isAdmin()
          || (resource == null
            && isPedidoParticipant(pedidoId)
            && pedidoAllowsParticipantWrites(pedidoId))
        )
        && validImageUpload(15 * 1024 * 1024);
      allow update: if isAdmin() && validImageUpload(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /chats/{pedidoId}/files/{fileName} {
      allow read: if isPedidoParticipant(pedidoId) || isAdmin();
      allow create: if (
          isAdmin()
          || (resource == null
            && isPedidoParticipant(pedidoId)
            && pedidoAllowsParticipantWrites(pedidoId))
        )
        && validUpload(20 * 1024 * 1024);
      allow update: if isAdmin() && validUpload(20 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /chats/{pedidoId}/audio/{fileName} {
      allow read: if isPedidoParticipant(pedidoId) || isAdmin();
      allow create: if (
          isAdmin()
          || (resource == null
            && isPedidoParticipant(pedidoId)
            && pedidoAllowsParticipantWrites(pedidoId))
        )
        && validAudioUpload(20 * 1024 * 1024);
      allow update: if isAdmin() && validAudioUpload(20 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /users/{userId}/{fileName} {
      allow read, write: if false;
    }

    match /profile_public/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if (
          isAdmin()
          || (uid() == userId && isActivePilotParticipant())
        )
        && validImageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    match /portfolio/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if (
          isAdmin()
          || (uid() == userId
            && isActivePilotParticipantForRole('prestador'))
        )
        && validImageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    match /prestadores/{prestadorId}/{fileName} {
      allow read, write: if false;
    }

    match /prestadores/{prestadorId}/portfolio/{fileName} {
      allow read, write: if false;
    }

    match /kyc_pending/{prestadorId}/{submissionId}/{fileName} {
      allow read: if isAdmin();
      allow create: if uid() == prestadorId
        && isActivePilotParticipantForRole('prestador')
        && canUploadKyc()
        && hasActiveKycUploadGrant(prestadorId, submissionId)
        && validImageUpload(10 * 1024 * 1024);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /kyc/{prestadorId}/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /stories/{prestadorId}/{fileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
