# =========================================
# ChegaJá v2.5 — Cloud Functions (EXEMPLO)
#
# Copia para `functions/.env` (apenas local).
# Em produção usa Firebase Secrets / env vars.
# =========================================

# Stripe secret key (NUNCA no app)
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (Stripe → Functions)
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Places / Maps (server-side)
# Usa functions/.env.local para estas chaves (evita conflito com Secrets).
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Base URL do teu domínio (para account links)
APP_BASE_URL=https://app.chegaja.pt

# Região (opcional)
FUNCTIONS_REGION=europe-west1

# Feature flags autoritativas (independentes das flags Flutter)
ENABLE_KYC=false
ENABLE_STRIPE=false
# Validacao comercial e tecnica para a moeda do PILOT_MARKET_ID ativo.
STRIPE_MARKET_VALIDATED=false
# Compatibilidade legada exclusiva do mercado mz-maputo.
STRIPE_MZN_VALIDATED=false
# Requer Stripe validado e uma decisao operacional separada.
ENABLE_SUBSCRIPTIONS=false
ENABLE_NO_SHOW_REPORTING=false
ENABLE_MPESA=false
ENABLE_EMOLA=false
# Compatibilidade legada: se definido, tem obrigatoriamente de coincidir com
# a moeda do PILOT_MARKET_ID. O contrato de mercado continua autoritativo.
DEFAULT_CURRENCY_CODE=EUR
# Hipóteses de piloto: têm de ser aprovadas e configuradas explicitamente.
DEFAULT_CASH_COMMISSION_RATE=0.10
DEFAULT_DIGITAL_COMMISSION_RATE=0.15
COMMISSION_FREE_FIRST_JOBS=2
# Opcional: teto absoluto por trabalho; vazio significa sem teto.
CASH_COMMISSION_CAP=
# Legado exclusivo de mz-maputo; preferir CASH_COMMISSION_CAP.
# CASH_COMMISSION_CAP_MZN=
COMMISSION_GRACE_DAYS=7
MAX_COMMISSION_DEBT=100
# Legado exclusivo de mz-maputo; preferir MAX_COMMISSION_DEBT.
# MAX_COMMISSION_DEBT_MZN=100

# Segredo aleatorio de alta entropia usado apenas pelo backend para
# pseudonimizar identificadores quando uma conta e eliminada.
ACCOUNT_DELETION_PEPPER=

# Mercado autoritativo do piloto controlado. Valores suportados:
# pt-coimbra (PT/EUR) e mz-maputo (MZ/MZN).
PILOT_MARKET_ID=pt-coimbra
# Em producao a allowlist e obrigatoria por defeito mesmo se esta variavel for
# omitida; definir false exige decisao operacional.
PILOT_REQUIRE_ALLOWLIST=true
# Obsoleto: a seleção de mercado é feita apenas por PILOT_MARKET_ID.
# Se a variável faltar, cliente e backend usam Coimbra como default seguro.
# PILOT_MAPUTO_ONLY=true
PILOT_ALLOWED_ZONES=coimbra
PILOT_MIN_LAT=40.13
PILOT_MAX_LAT=40.30
PILOT_MIN_LNG=-8.52
PILOT_MAX_LNG=-8.30

# Protecao de abuso. Ajustar apenas com dados do piloto.
RATE_LIMIT_CALLABLES_PER_MINUTE=90
RATE_LIMIT_PLACES_AUTOCOMPLETE=30
RATE_LIMIT_PLACES_DETAILS=20
RATE_LIMIT_DIRECTIONS=20
# Uma oportunidade geográfica server-side expira rapidamente e só pode ser
# aceite uma vez. O segundo limite reduz colheita abusiva de dados privados.
PROVIDER_OPPORTUNITY_TTL_MINUTES=15
PROVIDER_LOCATION_MAX_AGE_MINUTES=30
PROVIDER_ACCEPTANCES_PER_HOUR=5

# CORS web estrito; apps Android/iOS nao enviam Origin.
ALLOWED_WEB_ORIGINS=https://chegaja.com,https://www.chegaja.com,https://chegaja-ac88d.web.app,https://chegaja-ac88d.firebaseapp.com
