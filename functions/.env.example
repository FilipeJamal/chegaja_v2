# =========================================
# ChegaJÃ¡ v2.5 â€” Cloud Functions (EXEMPLO)
#
# Copia para `functions/.env` (apenas local).
# Em produÃ§Ã£o usa Firebase Secrets / env vars.
# =========================================

# Stripe secret key (NUNCA no app)
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (Stripe â†’ Functions)
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Places / Maps (server-side)
# Usa functions/.env.local para estas chaves (evita conflito com Secrets).
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Base URL do teu domÃ­nio (para account links)
APP_BASE_URL=https://app.chegaja.pt

# ComissÃ£o (ex.: 0.15 = 15%)
DEFAULT_COMMISSION_RATE=0.15

# RegiÃ£o (opcional)
FUNCTIONS_REGION=europe-west1

# Feature flags autoritativas (independentes das flags Flutter)
ENABLE_KYC=false
ENABLE_STRIPE=false
STRIPE_MZN_VALIDATED=false
ENABLE_MPESA=false
ENABLE_EMOLA=false
DEFAULT_CURRENCY_CODE=MZN
DEFAULT_CASH_COMMISSION_RATE=0.10
DEFAULT_DIGITAL_COMMISSION_RATE=0.15
COMMISSION_FREE_FIRST_JOBS=2
# Opcional: teto absoluto por trabalho; vazio significa sem teto.
CASH_COMMISSION_CAP_MZN=
COMMISSION_GRACE_DAYS=7
MAX_COMMISSION_DEBT_MZN=100

# Segredo aleatorio de alta entropia usado apenas pelo backend para
# pseudonimizar identificadores quando uma conta e eliminada.
ACCOUNT_DELETION_PEPPER=

# Piloto controlado. Em producao a allowlist e obrigatoria por defeito mesmo
# se esta variavel for omitida; definir false exige decisao operacional.
PILOT_REQUIRE_ALLOWLIST=true
PILOT_MAPUTO_ONLY=true
PILOT_ALLOWED_ZONES=maputo,matola
PILOT_MIN_LAT=-26.20
PILOT_MAX_LAT=-25.60
PILOT_MIN_LNG=32.20
PILOT_MAX_LNG=33.00

# Protecao de abuso. Ajustar apenas com dados do piloto.
RATE_LIMIT_CALLABLES_PER_MINUTE=90
RATE_LIMIT_PLACES_AUTOCOMPLETE=30
RATE_LIMIT_PLACES_DETAILS=20
RATE_LIMIT_DIRECTIONS=20

# CORS web estrito; apps Android/iOS nao enviam Origin.
ALLOWED_WEB_ORIGINS=https://chegaja.com,https://www.chegaja.com,https://chegaja-ac88d.web.app,https://chegaja-ac88d.firebaseapp.com
