# =========================================
# ChegaJÃ¡ v2.5 â€” ConfiguraÃ§Ã£o (EXEMPLO)
#
# Copia este ficheiro para `.env` e preenche.
# NÃƒO coloques aqui chaves secretas em builds de produÃ§Ã£o.
# =========================================

# -------- App (Flutter) --------
# Web Push (FCM)
FCM_VAPID_KEY=

# Stripe (PUBLICÃVEL)
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Google Places (Autocomplete/Geocoding)
GOOGLE_PLACES_API_KEY=

# Google Maps (SDKs / Web)
GOOGLE_MAPS_API_KEY=

# Ativar emuladores Firebase no DEV
USE_FIREBASE_EMULATORS=true
FIREBASE_EMULATOR_HOST=localhost
# RegiÃ£o das Functions (alinha com Firebase Functions)
FIREBASE_FUNCTIONS_REGION=europe-west1

# ForÃ§ar Semantics no Web (Ãºtil para Playwright)
FORCE_WEB_SEMANTICS=true

# Funcionalidades de risco ficam desligadas ate o backend e a operacao do
# piloto as ativarem explicitamente. KYC exige tambem a claim server-side.
ENABLE_KYC=false
ENABLE_STRIPE=false
STRIPE_MZN_VALIDATED=false
ENABLE_MPESA=false
ENABLE_EMOLA=false
DEFAULT_CURRENCY_CODE=EUR

# Escopo operacional do piloto. O codigo das funcionalidades continua no
# repositorio, mas fica indisponivel enquanto estas flags estiverem desligadas.
PILOT_MODE=true
PILOT_PORTUGUESE_ONLY=true
PILOT_MARKET_LOCKED=true
PILOT_MARKET_ID=pt-coimbra
ENABLE_STORIES=false
ENABLE_CALLS=false
ENABLE_NO_SHOW_REPORTING=false
ENABLE_SUBSCRIPTIONS=false
ENABLE_ADVANCED_RANKING=false
ENABLE_WINDOWS_PUBLIC=false
ENABLE_ANALYTICS=false
ENABLE_U6_PAYMENTS_V2=false
ENABLE_U12_INTERNATIONALIZATION_V2=false
GLOBAL_KILL_SWITCH=false

# Responsavel confirmado pelo projeto. O ChegaJa ainda nao e uma empresa
# constituida. NUIT/NIF pessoais nao devem ser versionados neste ficheiro.
LEGAL_ENTITY_NAME=Filipe Bento Jamal
LEGAL_ENTITY_TYPE=individual_project_promoter
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=

# URL base do teu domÃ­nio (para App Links / Universal Links)
APP_BASE_URL=https://app.chegaja.exemplo
