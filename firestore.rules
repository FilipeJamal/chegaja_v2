rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helpers
    // -------------------------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function hasVerifiedPhone() {
      return signedIn()
        && request.auth.token != null
        && request.auth.token.keys().hasAny(['phone_number'])
        && request.auth.token['phone_number'] is string
        && request.auth.token['phone_number'].size() >= 8;
    }

    // Admin claim SAFE: se nÃ£o existir, devolve false
    function isAdmin() {
      return signedIn()
        && request.auth.token != null
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token['admin'] == true;
    }

    // DEV MODE (manual):
    // - deixa true enquanto estÃ¡s a desenvolver / emuladores
    // - muda para false antes de fazer deploy para produÃ§Ã£o
    function devMode() { return false; }

    function isSelf(userId) { return signedIn() && uid() == userId; }

    function activePilotParticipantData() {
      return signedIn()
        ? get(/databases/$(database)/documents/pilot_participants/$(uid())).data
        : null;
    }

    function isActivePilotParticipantForRole(role) {
      let participant = activePilotParticipantData();
      return hasVerifiedPhone()
        && participant is map
        && participant.keys().hasAny(['status'])
        && participant['status'] == 'active'
        && participant.keys().hasAny(['roles'])
        && participant['roles'] is list
        && participant['roles'].hasAny([role]);
    }

    function accountAllowsPublicActivity(userId) {
      let account = get(/databases/$(database)/documents/users_private/$(userId));
      return account.data is map
        && (!account.data.keys().hasAny(['accountStatus'])
          || account.data['accountStatus'] == 'active');
    }
    function clienteIdFromData(data) {
      return data is map
        ? (data.keys().hasAny(['clienteId'])
          ? data['clienteId']
          : (data.keys().hasAny(['clientId']) ? data['clientId'] : null))
        : null;
    }


    // -------------------------
    // Pedido helpers
    // -------------------------
    function pedidoSnap(pedidoId) {
      return get(/databases/$(database)/documents/pedidos/$(pedidoId));
    }

    function providerHasFullPedidoAccess(data) {
      return signedIn()
        && data is map
        && data.keys().hasAll([
          'prestadorId',
          'providerAccessGranted',
          'providerAccessGrantedTo',
          'providerAccessGrantedAt'
        ])
        && data['prestadorId'] == uid()
        && data['providerAccessGranted'] == true
        && data['providerAccessGrantedTo'] == uid()
        && data['providerAccessGrantedAt'] is timestamp
        && data['providerAccessGrantedAt'] > timestamp.date(1970, 1, 1)
        && data['providerAccessGrantedAt'] < timestamp.date(2100, 1, 1)
        && pedidoAllowsProviderHistory(data);
    }

    function providerHasPedidoListAccess(data) {
      return signedIn()
        && data is map
        && data.keys().hasAll([
          'prestadorId',
          'providerAccessGranted',
          'providerAccessGrantedTo',
          'providerAccessGrantedAt'
        ])
        && data['prestadorId'] == uid()
        && data['providerAccessGranted'] == true
        && data['providerAccessGrantedTo'] == uid()
        && data['providerAccessGrantedAt'] > timestamp.date(1970, 1, 1)
        && data['providerAccessGrantedAt'] < timestamp.date(2100, 1, 1)
        // `status` is the authoritative lifecycle field for collection
        // queries. Requiring cross-field equality with the legacy `estado`
        // alias makes the query impossible to prove under Firestore Rules,
        // even when both values are equal. Single-document reads, chat and
        // Storage retain the stricter status/estado consistency check.
        && data.keys().hasAny(['status'])
        && data['status'] in [
          'aceito',
          'em_andamento',
          'aguarda_confirmacao_valor',
          'concluido'
        ];
    }

    function pedidoAllowsProviderHistory(data) {
      let hasStatus = data is map && data.keys().hasAny(['status']);
      let hasEstado = data is map && data.keys().hasAny(['estado']);
      let status = hasStatus ? data['status'] : null;
      let estado = hasEstado ? data['estado'] : null;
      let lifecycle = status is string ? status : estado;
      return lifecycle in [
          'aceito',
          'em_andamento',
          'aguarda_confirmacao_valor',
          'concluido'
        ]
        && (!hasStatus || !hasEstado || status == estado);
    }

    function pedidoAllowsParticipantWrites(data) {
      let hasStatus = data is map && data.keys().hasAny(['status']);
      let hasEstado = data is map && data.keys().hasAny(['estado']);
      let status = hasStatus ? data['status'] : null;
      let estado = hasEstado ? data['estado'] : null;
      let lifecycle = status is string ? status : estado;
      return lifecycle in [
          'criado',
          'aguarda_resposta_prestador',
          'aguarda_resposta_cliente',
          'aceito',
          'em_andamento',
          'aguarda_confirmacao_valor'
        ]
        && (!hasStatus || !hasEstado || status == estado);
    }

    // âœ… Quando estamos fora do match /pedidos, precisamos ler o pedido por ID.
    function isPedidoParticipantById(pedidoId) {
      let p = pedidoSnap(pedidoId).data;
      return signedIn() && p is map
        ? (
          clienteIdFromData(p) == uid() || providerHasFullPedidoAccess(p)
        )
        : false;
    }

    // âœ… Quando jÃ¡ temos o doc (resource.data), NÃƒO uses get()
    function isPedidoParticipantByData(data) {
      return signedIn()
        && data is map
        && (
          clienteIdFromData(data) == uid() || providerHasFullPedidoAccess(data)
        );
    }

    function isActivePilotPedidoParticipantByData(data) {
      return signedIn()
        && data is map
        && (
          (clienteIdFromData(data) == uid()
            && isActivePilotParticipantForRole('cliente'))
          || (
            providerHasFullPedidoAccess(data)
            && isActivePilotParticipantForRole('prestador')
          )
        );
    }

    function isActivePilotPedidoListParticipant(data) {
      return signedIn()
        && data is map
        && request.query.limit != null
        && request.query.limit <= 200
        && (
          (clienteIdFromData(data) == uid()
            && isActivePilotParticipantForRole('cliente'))
          || (
            providerHasPedidoListAccess(data)
            && isActivePilotParticipantForRole('prestador')
          )
        );
    }

    function isActivePilotPedidoParticipantById(pedidoId) {
      return isActivePilotPedidoParticipantByData(pedidoSnap(pedidoId).data);
    }

    function isActivePilotPedidoActorForUpdate() {
      let currentPrestadorId = fieldValueOrNull(resource.data, 'prestadorId');
      let nextPrestadorId = fieldValueOrNull(request.resource.data, 'prestadorId');
      return (
          clienteIdFromData(resource.data) == uid()
          && isActivePilotParticipantForRole('cliente')
        ) || (
          (currentPrestadorId == uid()
            || (currentPrestadorId == null && nextPrestadorId == uid()))
          && isActivePilotParticipantForRole('prestador')
        );
    }

    function isSanitizedPedidoDispatch(data) {
      return data is map
        && data.keys().hasAll([
          'pedidoId',
          'status',
          'prestadorId',
          'targetProviderId'
        ])
        && data.keys().hasOnly([
          'pedidoId',
          'servicoId',
          'servicoNome',
          'categoria',
          'modo',
          'agendadoPara',
          'tipoPreco',
          'estado',
          'status',
          'prestadorId',
          'targetProviderId',
          'valorMinEstimadoPrestador',
          'valorMaxEstimadoPrestador',
          'statusProposta',
          'propostaExpiresAt',
          'zoneLabel',
          'enderecoTexto',
          'latitude',
          'longitude',
          'approximateDistanceKm',
          'categoryApprovalRequired',
          'categoryRequirementId',
          'categoryRequirementName',
          'categoryRiskLevel',
          'isCustomService',
          'createdAt',
          'updatedAt'
        ])
        && (!data.keys().hasAny(['valorMinEstimadoPrestador'])
          || data['valorMinEstimadoPrestador'] == null
          || data['valorMinEstimadoPrestador'] is number)
        && (!data.keys().hasAny(['valorMaxEstimadoPrestador'])
          || data['valorMaxEstimadoPrestador'] == null
          || data['valorMaxEstimadoPrestador'] is number)
        && (!data.keys().hasAny(['statusProposta'])
          || (data['statusProposta'] is string
            && data['statusProposta'].size() <= 40))
        && (!data.keys().hasAny(['propostaExpiresAt'])
          || data['propostaExpiresAt'] == null
          || data['propostaExpiresAt'] is timestamp)
        && (!data.keys().hasAny(['enderecoTexto'])
          || (data.keys().hasAny(['zoneLabel'])
            && data['enderecoTexto'] is string
            && data['zoneLabel'] is string
            && data['enderecoTexto'] == data['zoneLabel']));
    }

    function canReadPedidoDispatch(data) {
      let noAssignedProvider = data['prestadorId'] == null;
      let noTargetProvider = data['targetProviderId'] == null;
      return isSanitizedPedidoDispatch(data)
        && noAssignedProvider
        && (
          (data['status'] == 'criado' && noTargetProvider)
          || data['targetProviderId'] == uid()
        );
    }

    // LIST queries cannot prove a structural keys().hasOnly() predicate.
    // Writes stay completely server-only and every GET remains shape-checked;
    // LIST is therefore constrained to the two relationship-safe views and a
    // bounded query. The Functions projection builder is the write contract.
    function canListPedidoDispatch(data) {
      let noAssignedProvider = data['prestadorId'] == null;
      let noTargetProvider = data['targetProviderId'] == null;
      return noAssignedProvider
        && request.query.limit != null
        && request.query.limit <= 100
        && (
          (data['status'] == 'criado' && noTargetProvider)
          || data['targetProviderId'] == uid()
        );
    }

    function isPrestador() {
      return signedIn()
        && exists(/databases/$(database)/documents/provider_public/$(uid()));
    }

    function providerMayReceiveDispatch() {
      let publicData = signedIn()
        && exists(/databases/$(database)/documents/provider_public/$(uid()))
        ? get(/databases/$(database)/documents/provider_public/$(uid())).data
        : {};
      let userPrivate = signedIn()
        && exists(/databases/$(database)/documents/users_private/$(uid()))
        ? get(/databases/$(database)/documents/users_private/$(uid())).data
        : {};
      let providerPrivate = signedIn()
        && exists(/databases/$(database)/documents/provider_private/$(uid()))
        ? get(/databases/$(database)/documents/provider_private/$(uid())).data
        : {};
      let dispatchPrivate = signedIn()
        && exists(/databases/$(database)/documents/provider_dispatch_private/$(uid()))
        ? get(/databases/$(database)/documents/provider_dispatch_private/$(uid())).data
        : {};
      let accountStatus = userPrivate is map
        && userPrivate.keys().hasAny(['accountStatus'])
        ? userPrivate['accountStatus']
        : '';
      return publicData is map
        && publicData.keys().hasAny(['isSearchable'])
        && publicData['isSearchable'] == true
        && !(accountStatus in [
          'deletion_pending',
          'disabled',
          'deleted',
          'suspended',
          'inactive',
          'blocked'
        ])
        && !(providerPrivate is map
          && providerPrivate.keys().hasAny(['financialStatus'])
          && providerPrivate['financialStatus'] == 'suspended_new_jobs')
        && !(dispatchPrivate is map
          && dispatchPrivate.keys().hasAny(['acceptingNewJobs'])
          && dispatchPrivate['acceptingNewJobs'] == false);
    }

    function providerOpportunityAccountIsEligible() {
      let publicData = signedIn()
        && exists(/databases/$(database)/documents/provider_public/$(uid()))
        ? get(/databases/$(database)/documents/provider_public/$(uid())).data
        : {};
      let dispatchPrivate = signedIn()
        && exists(/databases/$(database)/documents/provider_dispatch_private/$(uid()))
        ? get(/databases/$(database)/documents/provider_dispatch_private/$(uid())).data
        : {};
      return providerMayReceiveDispatch()
        && dispatchPrivate is map
        && dispatchPrivate.keys().hasAll([
          'acceptingRequests',
          'isOnline',
          'radiusKm',
          'lastLocation',
          'geo',
          'lastLocationAt'
        ])
        && dispatchPrivate['acceptingRequests'] == true
        && dispatchPrivate['isOnline'] == true
        && dispatchPrivate['radiusKm'] is number
        && dispatchPrivate['radiusKm'] >= 1
        && dispatchPrivate['radiusKm'] <= 50
        && validProviderDispatchOwnerState(dispatchPrivate, uid());
    }

    function providerMayGetOpportunity(data) {
      let publicData = get(
        /databases/$(database)/documents/provider_public/$(uid())
      ).data;
      let services = publicData is map
        && publicData.keys().hasAny(['servicos'])
        && publicData['servicos'] is list
        ? publicData['servicos']
        : [];
      return providerOpportunityAccountIsEligible()
        && data is map
        && data.keys().hasAll([
          'providerId',
          'pedidoId',
          'serviceId',
          'status',
          'expiresAt'
        ])
        && data['providerId'] == uid()
        && data['pedidoId'] is string
        && data['pedidoId'].size() > 0
        && data['serviceId'] is string
        && services.hasAny([data['serviceId']])
        && data['status'] == 'active'
        && data['expiresAt'] is timestamp
        && data['expiresAt'] > request.time;
    }

    // Collection queries cannot prove structural keys().hasAll() checks. The
    // backend is the only writer, so LIST is constrained to the owner,
    // lifecycle, expiry and a strict limit; GET retains the full shape check.
    function providerMayListOpportunity(data) {
      return providerOpportunityAccountIsEligible()
        && data['providerId'] == uid()
        && data['status'] == 'active'
        && data['expiresAt'] > request.time;
    }

    // -------------------------
    // Prestador <-> Pedido matching (business rule)
    // -------------------------
    function prestadorData() {
      return signedIn()
        ? get(/databases/$(database)/documents/provider_public/$(uid())).data
        : null;
    }

    function prestadorMatchesPedido(pedidoData) {
      let p = prestadorData();
      let servicos = (p is map && p.keys().hasAny(['servicos']) && p['servicos'] is list)
        ? p['servicos']
        : [];
      let servicosNomes = (p is map && p.keys().hasAny(['servicosNomes']) && p['servicosNomes'] is list)
        ? p['servicosNomes']
        : [];
      let servicoId = (pedidoData is map && pedidoData.keys().hasAny(['servicoId']))
        ? pedidoData['servicoId']
        : null;

      // Prefer "servicoNome" and fallback to legacy "categoria".
      let categoria = (pedidoData is map && pedidoData.keys().hasAny(['servicoNome']) && pedidoData['servicoNome'] != null)
        ? pedidoData['servicoNome']
        : ((pedidoData is map && pedidoData.keys().hasAny(['categoria'])) ? pedidoData['categoria'] : null);

      return (servicoId is string && servicos.hasAny([servicoId]))
        || (categoria is string && servicosNomes.hasAny([categoria]));
    }

    function prestadorApprovedForSensitivePedido(pedidoData) {
      let p = prestadorData();
      let approvedSensitiveCategoryIds = (p is map && p.keys().hasAny(['approvedSensitiveCategoryIds']) && p['approvedSensitiveCategoryIds'] is list)
        ? p['approvedSensitiveCategoryIds']
        : [];
      let servicoId = (pedidoData is map && pedidoData.keys().hasAny(['servicoId']))
        ? pedidoData['servicoId']
        : null;
      return !(pedidoData is map
          && pedidoData.keys().hasAny(['categoryApprovalRequired'])
          && pedidoData['categoryApprovalRequired'] == true)
        || (servicoId is string && approvedSensitiveCategoryIds.hasAny([servicoId]));
    }

    function pedidoEstado(data) {
      return !(data is map)
        ? null
        : (data.keys().hasAny(['status'])
          ? data['status']
          : (data.keys().hasAny(['estado']) ? data['estado'] : null));
    }

    function validAvaliacaoComentario(data) {
      return !data.keys().hasAny(['comentario']) ||
        (data['comentario'] is string && data['comentario'].size() <= 500);
    }

    function validAvaliacaoCreate(avaliacaoId) {
      let data = request.resource.data;
      let pedido = pedidoSnap(data['pedidoId']).data;
      return hasVerifiedPhone()
        && data.keys().hasOnly([
          'pedidoId',
          'clienteId',
          'prestadorId',
          'estrelas',
          'comentario',
          'createdAt',
        ])
        && data.keys().hasAll([
          'pedidoId',
          'clienteId',
          'prestadorId',
          'estrelas',
          'createdAt',
        ])
        && data['pedidoId'] is string
        && data['pedidoId'].size() > 0
        && data['clienteId'] is string
        && data['clienteId'] == uid()
        && avaliacaoId == data['pedidoId'] + '_' + uid()
        && data['prestadorId'] is string
        && data['prestadorId'].size() > 0
        && data['estrelas'] is int
        && data['estrelas'] >= 1
        && data['estrelas'] <= 5
        && validAvaliacaoComentario(data)
        && data['createdAt'] is timestamp
        && data['createdAt'] == request.time
        && pedido is map
        && clienteIdFromData(pedido) == uid()
        && pedidoEstado(pedido) == 'concluido'
        && pedido.keys().hasAny(['prestadorId'])
        && pedido['prestadorId'] == data['prestadorId'];
    }

    function isModerator() {
      return signedIn()
        && request.auth.token != null
        && request.auth.token.keys().hasAny(['moderator'])
        && request.auth.token['moderator'] == true;
    }

    function canModerate() {
      return isAdmin() || isModerator() || devMode();
    }

    function allowedReportTargetType(value) {
      return value in [
        'provider_profile',
        'client_profile',
        'portfolio_media',
        'story',
        'chat_message',
        'review',
        'service_category',
        'service_request',
        'user',
        'other',
      ];
    }

    function allowedReportReasonCode(value) {
      return value in [
        'illegal_service',
        'sexual_content',
        'drugs',
        'fraud',
        'harassment',
        'hate_speech',
        'violence',
        'child_safety',
        'personal_data',
        'spam',
        'scam',
        'impersonation',
        'unsafe_service',
        'copyright_or_stolen_media',
        'off_platform_circumvention',
        'other',
      ];
    }

    function allowedReportSeverity(value) {
      return value in ['low', 'medium', 'high', 'critical'];
    }

    function validOptionalString(data, key, maxLength) {
      return !data.keys().hasAny([key]) ||
        (data[key] is string && data[key].size() <= maxLength);
    }

    function validOptionalList(data, key, maxItems) {
      return !data.keys().hasAny([key]) ||
        (data[key] is list && data[key].size() <= maxItems);
    }

    function validOptionalTimestamp(data, key) {
      return !data.keys().hasAny([key]) || data[key] is timestamp;
    }

    function allowedCategoryRiskLevel(value) {
      return value in ['normal', 'sensitive', 'prohibited'];
    }

    function validEvidenceTypesList(value, maxItems) {
      return value is list
        && value.size() <= maxItems
        && value.hasOnly([
          'certificate',
          'license',
          'work_experience',
          'portfolio_reference',
          'external_profile',
          'declaration',
          'other',
        ]);
    }

    function allowedSensitiveCategoryRequestStatus(value) {
      return value in [
        'draft',
        'submitted',
        'pending_review',
        'approved',
        'rejected',
        'needs_more_info',
        'expired',
        'revoked',
      ];
    }

    function allowedProviderEditableSensitiveRequestStatus(value) {
      return value in ['draft', 'submitted', 'pending_review'];
    }

    function allowedProviderCategoryApprovalStatus(value) {
      return value in [
        'approved',
        'rejected',
        'suspended',
        'expired',
        'revoked',
      ];
    }

    function validCategoryRequirementData(data) {
      return data is map
        && data.keys().hasOnly([
          'categoryId',
          'categoryName',
          'riskLevel',
          'approvalRequired',
          'evidenceTypes',
          'description',
          'userMessage',
          'adminNotes',
          'isActive',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'categoryId',
          'categoryName',
          'riskLevel',
          'approvalRequired',
          'evidenceTypes',
          'isActive',
        ])
        && data['categoryId'] is string
        && data['categoryId'].size() > 0
        && data['categoryName'] is string
        && data['categoryName'].size() > 0
        && allowedCategoryRiskLevel(data['riskLevel'])
        && data['approvalRequired'] is bool
        && validEvidenceTypesList(data['evidenceTypes'], 10)
        && data['isActive'] is bool
        && validOptionalString(data, 'description', 1000)
        && validOptionalString(data, 'userMessage', 500)
        && validOptionalString(data, 'adminNotes', 2000)
        && validOptionalTimestamp(data, 'createdAt')
        && validOptionalTimestamp(data, 'updatedAt');
    }

    function validSensitiveCategoryRequestData(data) {
      return data is map
        && data.keys().hasOnly([
          'providerId',
          'categoryId',
          'categoryName',
          'status',
          'evidenceTypes',
          'evidenceText',
          'portfolioUrls',
          'documentRefs',
          'createdAt',
          'updatedAt',
          'submittedAt',
          'reviewedBy',
          'reviewedAt',
          'decisionReason',
          'expiresAt',
        ])
        && data.keys().hasAll([
          'providerId',
          'categoryId',
          'categoryName',
          'status',
          'evidenceTypes',
          'portfolioUrls',
          'documentRefs',
        ])
        && data['providerId'] is string
        && data['providerId'].size() > 0
        && data['categoryId'] is string
        && data['categoryId'].size() > 0
        && data['categoryName'] is string
        && data['categoryName'].size() > 0
        && allowedSensitiveCategoryRequestStatus(data['status'])
        && validEvidenceTypesList(data['evidenceTypes'], 10)
        && validOptionalString(data, 'evidenceText', 2000)
        && validOptionalList(data, 'portfolioUrls', 20)
        && validOptionalList(data, 'documentRefs', 20)
        && validOptionalTimestamp(data, 'createdAt')
        && validOptionalTimestamp(data, 'updatedAt')
        && validOptionalTimestamp(data, 'submittedAt')
        && validOptionalString(data, 'reviewedBy', 128)
        && validOptionalTimestamp(data, 'reviewedAt')
        && validOptionalString(data, 'decisionReason', 1000)
        && validOptionalTimestamp(data, 'expiresAt');
    }

    function validProviderSensitiveCategoryRequestCreate() {
      let data = request.resource.data;
      return signedIn()
        && validSensitiveCategoryRequestData(data)
        && data['providerId'] == uid()
        && allowedProviderEditableSensitiveRequestStatus(data['status'])
        && !data.keys().hasAny([
          'reviewedBy',
          'reviewedAt',
          'decisionReason',
          'expiresAt',
        ]);
    }

    function validProviderSensitiveCategoryRequestUpdate() {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      return signedIn()
        && resource.data['providerId'] == uid()
        && resource.data['status'] in ['draft', 'needs_more_info']
        && validSensitiveCategoryRequestData(data)
        && data['providerId'] == resource.data['providerId']
        && data['categoryId'] == resource.data['categoryId']
        && affected.hasOnly([
          'status',
          'evidenceTypes',
          'evidenceText',
          'portfolioUrls',
          'documentRefs',
          'submittedAt',
          'updatedAt',
        ])
        && (!affected.hasAny(['status']) ||
          allowedProviderEditableSensitiveRequestStatus(data['status']));
    }

    function validProviderCategoryApprovalData(data, providerId, categoryId) {
      return data is map
        && data.keys().hasOnly([
          'providerId',
          'categoryId',
          'categoryName',
          'status',
          'sourceRequestId',
          'approvedBy',
          'approvedAt',
          'expiresAt',
          'revokedAt',
          'decisionReason',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'providerId',
          'categoryId',
          'categoryName',
          'status',
        ])
        && data['providerId'] == providerId
        && data['categoryId'] == categoryId
        && data['categoryName'] is string
        && data['categoryName'].size() > 0
        && allowedProviderCategoryApprovalStatus(data['status'])
        && validOptionalString(data, 'sourceRequestId', 128)
        && validOptionalString(data, 'approvedBy', 128)
        && validOptionalTimestamp(data, 'approvedAt')
        && validOptionalTimestamp(data, 'expiresAt')
        && validOptionalTimestamp(data, 'revokedAt')
        && validOptionalString(data, 'decisionReason', 1000)
        && validOptionalTimestamp(data, 'createdAt')
        && validOptionalTimestamp(data, 'updatedAt');
    }

    function validReportCreate() {
      let data = request.resource.data;
      return hasVerifiedPhone()
        && data.keys().hasOnly([
          'reporterId',
          'targetType',
          'targetId',
          'targetOwnerId',
          'reasonCode',
          'severity',
          'details',
          'status',
          'createdAt',
          'updatedAt',
          'sourceContext',
          'pedidoId',
          'chatId',
          'messageId',
          'mediaUrl',
          'mediaPath',
        ])
        && data.keys().hasAll([
          'reporterId',
          'targetType',
          'targetId',
          'reasonCode',
          'severity',
          'status',
          'createdAt',
          'updatedAt',
        ])
        && data['reporterId'] is string
        && data['reporterId'] == uid()
        && data['targetType'] is string
        && allowedReportTargetType(data['targetType'])
        && data['targetId'] is string
        && data['targetId'].size() > 0
        && data['reasonCode'] is string
        && allowedReportReasonCode(data['reasonCode'])
        && data['severity'] is string
        && allowedReportSeverity(data['severity'])
        && data['status'] == 'pending_review'
        && validOptionalString(data, 'targetOwnerId', 128)
        && validOptionalString(data, 'details', 1000)
        && validOptionalString(data, 'sourceContext', 120)
        && validOptionalString(data, 'pedidoId', 128)
        && validOptionalString(data, 'chatId', 128)
        && validOptionalString(data, 'messageId', 128)
        && validOptionalString(data, 'mediaUrl', 1000)
        && validOptionalString(data, 'mediaPath', 500)
        && data['createdAt'] is timestamp
        && data['createdAt'] == request.time
        && data['updatedAt'] is timestamp
        && data['updatedAt'] == request.time;
    }

    function validBlockedUserCreate(userId, blockedUid) {
      let data = request.resource.data;
      return isSelf(userId)
        && blockedUid is string
        && blockedUid.size() > 0
        && blockedUid != userId
        && data.keys().hasOnly(['blockedUid', 'createdAt', 'reason', 'source'])
        && data.keys().hasAll(['blockedUid', 'createdAt'])
        && data['blockedUid'] is string
        && data['blockedUid'] == blockedUid
        && validOptionalString(data, 'reason', 500)
        && validOptionalString(data, 'source', 120)
        && data['createdAt'] is timestamp
        && data['createdAt'] == request.time;
    }

    function providerPublicOwnerFields() {
      return [
        'uid',
        'userId',
        'nome',
        'displayName',
        'photoUrl',
        'fotoUrl',
        'bio',
        'city',
        'state',
        'country',
        'countryCode',
        'stateCode',
        'radiusKm',
        'portfolioUrls',
        'portfolioImages',
        'createdAt',
        'updatedAt',
        'isSearchable',
      ];
    }

    function validPrestadorOwnerCreate(prestadorId) {
      return isSelf(prestadorId)
        && request.resource.data.keys().hasOnly(providerPublicOwnerFields())
        && (!request.resource.data.keys().hasAny(['uid']) ||
          request.resource.data['uid'] == prestadorId)
        && (!request.resource.data.keys().hasAny(['userId']) ||
          request.resource.data['userId'] == prestadorId)
        && (!request.resource.data.keys().hasAny(['isSearchable']) ||
          request.resource.data['isSearchable'] == false);
    }

    function validPrestadorOwnerUpdate(prestadorId) {
      return isSelf(prestadorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'displayName',
          'photoUrl',
          'fotoUrl',
          'bio',
          'city',
          'state',
          'country',
          'countryCode',
          'stateCode',
          'radiusKm',
          'portfolioUrls',
          'portfolioImages',
          'updatedAt',
        ]);
    }

    function validPublicProfileOwnerWrite(profileId) {
      return isSelf(profileId)
        && (
          isActivePilotParticipantForRole('cliente')
          || isActivePilotParticipantForRole('prestador')
        )
        && accountAllowsPublicActivity(profileId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'nome',
          'displayName',
          'photoUrl',
          'fotoUrl',
          'bio',
          'city',
          'state',
          'province',
          'country',
          'countryCode',
          'stateCode',
          'createdAt',
          'updatedAt',
        ])
        && (!request.resource.data.keys().hasAny(['uid']) ||
          request.resource.data['uid'] == profileId);
    }

    function providerDispatchOwnerFields() {
      return [
        'providerId',
        'isOnline',
        'lastLocation',
        'geo',
        'radiusKm',
        'workingHours',
        'blockedDates',
        'lastSeenAt',
        'lastLocationAt',
        'createdAt',
        'updatedAt',
      ];
    }

    function validProviderDispatchLocation(data) {
      let hasLocation = data.keys().hasAny(['lastLocation']);
      let hasGeo = data.keys().hasAny(['geo']);
      let location = hasLocation ? data['lastLocation'] : null;
      let geo = hasGeo ? data['geo'] : null;
      return (!hasLocation && !hasGeo)
        || (
          hasLocation
          && hasGeo
          && location is map
          && location.keys().hasOnly(['lat', 'lng'])
          && location.keys().hasAll(['lat', 'lng'])
          && location['lat'] is number
          && location['lat'] >= -90
          && location['lat'] <= 90
          && location['lng'] is number
          && location['lng'] >= -180
          && location['lng'] <= 180
          && geo is map
          && geo.keys().hasOnly(['geohash', 'geopoint'])
          && geo.keys().hasAll(['geohash', 'geopoint'])
          && geo['geohash'] is string
          && geo['geohash'].size() >= 5
          && geo['geohash'].size() <= 12
          && geo['geopoint'] is latlng
          && geo['geopoint'].latitude() == location['lat']
          && geo['geopoint'].longitude() == location['lng']
        );
    }

    function validProviderDispatchOwnerState(data, providerId) {
      let online = data.keys().hasAny(['isOnline']) && data['isOnline'] == true;
      return (!data.keys().hasAny(['providerId']) || data['providerId'] == providerId)
        && (!data.keys().hasAny(['isOnline']) || data['isOnline'] is bool)
        && (!data.keys().hasAny(['radiusKm'])
          || (data['radiusKm'] is number
            && data['radiusKm'] >= 1
            && data['radiusKm'] <= 50))
        && (!data.keys().hasAny(['lastSeenAt']) || data['lastSeenAt'] is timestamp)
        && (!data.keys().hasAny(['lastLocationAt']) || data['lastLocationAt'] is timestamp)
        && (!data.keys().hasAny(['createdAt']) || data['createdAt'] is timestamp)
        && (!data.keys().hasAny(['updatedAt']) || data['updatedAt'] is timestamp)
        && validProviderDispatchLocation(data)
        && (!online || (
          data.keys().hasAll(['lastLocation', 'geo', 'lastLocationAt'])
          && data['lastLocationAt'] >= request.time - duration.value(30, 'm')
        ));
    }

    function validProviderDispatchData(data, providerId) {
      return data.keys().hasOnly(providerDispatchOwnerFields())
        && validProviderDispatchOwnerState(data, providerId);
    }

    function validProviderDispatchOwnerCreate(providerId) {
      return isSelf(providerId)
        && validProviderDispatchData(request.resource.data, providerId)
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data['createdAt'] == request.time)
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data['updatedAt'] == request.time)
        && (!request.resource.data.keys().hasAny(['lastLocationAt'])
          || request.resource.data['lastLocationAt'] == request.time);
    }

    function validProviderDispatchOwnerUpdate(providerId) {
      return isSelf(providerId)
        && validProviderDispatchOwnerState(request.resource.data, providerId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(providerDispatchOwnerFields())
        && (!request.resource.data.keys().hasAny(['providerId']) ||
          request.resource.data['providerId'] == providerId)
        && (!resource.data.keys().hasAny(['providerId']) ||
          (request.resource.data.keys().hasAny(['providerId']) &&
            request.resource.data['providerId'] == resource.data['providerId']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data['updatedAt'] == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['lastLocation', 'geo', 'lastLocationAt'])
          || (request.resource.data['lastLocationAt'] == request.time
            && request.resource.data['updatedAt'] == request.time));
    }

    function userPrivateOwnerFields() {
      return [
        'uid',
        'isAnonymous',
        'region',
        'activeRole',
        'roles',
        'phoneRaw',
        'phoneE164',
        'phoneIsoCode',
        'phoneNsn',
        'phoneCountryCode',
        'fcmToken',
        'fcmTokenPlatform',
        'fcmTokenUpdatedAt',
        'isOnline',
        'lastSeenAt',
        'lastLoginAt',
        'createdAt',
        'updatedAt',
      ];
    }

    function validUserPrivateOwnerCreate(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasOnly(userPrivateOwnerFields())
        && (!request.resource.data.keys().hasAny(['uid']) ||
          request.resource.data['uid'] == userId);
    }

    function validUserPrivateOwnerUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'region',
          'activeRole',
          'roles',
          'phoneRaw',
          'phoneE164',
          'phoneIsoCode',
          'phoneNsn',
          'phoneCountryCode',
          'fcmToken',
          'fcmTokenPlatform',
          'fcmTokenUpdatedAt',
          'isOnline',
          'lastSeenAt',
          'lastLoginAt',
          'updatedAt',
        ]);
    }

    function isValidPedidoEstadoValue(value) {
      return value is string
        && value in [
          'criado',
          'aguarda_resposta_prestador',
          'aguarda_resposta_cliente',
          'aceito',
          'em_andamento',
          'aguarda_confirmacao_valor',
          'concluido',
          'cancelado'
        ];
    }

    function hasValidPedidoEstado(data) {
      return data is map
        && data.keys().hasAny(['status', 'estado'])
        && (!data.keys().hasAll(['status', 'estado']) ||
          data['status'] == data['estado'])
        && (!data.keys().hasAny(['status']) ||
          isValidPedidoEstadoValue(data['status']))
        && (!data.keys().hasAny(['estado']) ||
          isValidPedidoEstadoValue(data['estado']));
    }

    // Pedido â€œabertoâ€ = visÃ­vel para prestadores na lista
    function pedidoAberto(data) {
      return data is map
        && pedidoEstado(data) == 'criado'
        && (!data.keys().hasAny(['prestadorId']) ||
          data['prestadorId'] == null);
    }

    function immutableField(field) {
      return !resource.data.keys().hasAny([field]) ||
        request.resource.data[field] == resource.data[field];
    }

    function fieldValueOrNull(data, field) {
      return data is map && data.keys().hasAny([field])
        ? data[field]
        : null;
    }

    function isPedidoClienteActor() {
      return signedIn() && clienteIdFromData(resource.data) == uid();
    }

    function isPedidoPrestadorActorForUpdate() {
      let currentPrestadorId = fieldValueOrNull(resource.data, 'prestadorId');
      let nextPrestadorId = fieldValueOrNull(request.resource.data, 'prestadorId');
      return signedIn()
        && (currentPrestadorId == uid() ||
          (currentPrestadorId == null && nextPrestadorId == uid()));
    }

    function isAllowedClientePedidoTransition(from, to) {
      return (from == 'criado' &&
          (to == 'aguarda_resposta_prestador' || to == 'cancelado'))
        || (from == 'aguarda_resposta_prestador' && to == 'cancelado')
        || (from == 'aguarda_resposta_cliente' &&
          (to == 'aceito' || to == 'criado' || to == 'cancelado'))
        || (from == 'aceito' && to == 'cancelado')
        || (from == 'em_andamento' && to == 'cancelado')
        || (from == 'aguarda_confirmacao_valor' &&
          (to == 'concluido' || to == 'em_andamento' || to == 'cancelado'));
    }

    function isAllowedPrestadorPedidoTransition(from, to) {
      return (from == 'criado' &&
          (to == 'aceito' || to == 'aguarda_resposta_cliente'))
        || (from == 'aguarda_resposta_prestador' &&
          (to == 'aceito' || to == 'criado'))
        || (from == 'aguarda_resposta_cliente' && to == 'criado')
        || (from == 'aceito' &&
          (to == 'em_andamento' || to == 'aguarda_resposta_cliente' ||
            to == 'criado'))
        || (from == 'em_andamento' &&
          (to == 'aguarda_confirmacao_valor' || to == 'cancelado'))
        || (from == 'aguarda_confirmacao_valor' && to == 'cancelado');
    }

    function validPedidoStateTransition() {
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return currentEstado == nextEstado
        || (isPedidoClienteActor() &&
          isAllowedClientePedidoTransition(currentEstado, nextEstado))
        || (isPedidoPrestadorActorForUpdate() &&
          isAllowedPrestadorPedidoTransition(currentEstado, nextEstado));
    }

    function validPrestadorIdTransition() {
      let currentPrestadorId = fieldValueOrNull(resource.data, 'prestadorId');
      let nextPrestadorId = fieldValueOrNull(request.resource.data, 'prestadorId');
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return currentPrestadorId == nextPrestadorId
        || (
          currentPrestadorId == null &&
          nextPrestadorId == uid() &&
          isAllowedPrestadorPedidoTransition(currentEstado, nextEstado)
        )
        || (
          currentPrestadorId == null &&
          isPedidoClienteActor() &&
          currentEstado == 'criado' &&
          nextEstado == 'aguarda_resposta_prestador' &&
          nextPrestadorId is string
        )
        || (
          currentPrestadorId != null &&
          nextPrestadorId == null &&
          (
            (
              isPedidoClienteActor() &&
              currentEstado == 'aguarda_resposta_cliente' &&
              nextEstado == 'criado'
            ) ||
            (
              currentPrestadorId == uid() &&
              nextEstado == 'criado' &&
              isAllowedPrestadorPedidoTransition(currentEstado, nextEstado)
            )
          )
        );
    }

    function fieldUnchanged(field) {
      return fieldValueOrNull(request.resource.data, field) ==
        fieldValueOrNull(resource.data, field);
    }

    function validPedidoUpdatedAt() {
      return request.resource.data.keys().hasAny(['updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
        && request.resource.data['updatedAt'] is timestamp
        && request.resource.data['updatedAt'] == request.time;
    }

    function finalPricingFieldsUnchanged() {
      return fieldUnchanged('precoFinal')
        && fieldUnchanged('preco')
        && fieldUnchanged('commissionPlatform')
        && fieldUnchanged('earningsProvider')
        && fieldUnchanged('earningsTotal');
    }

    function finalProposalFieldsUnchanged() {
      return fieldUnchanged('precoPropostoPrestador')
        && fieldUnchanged('statusConfirmacaoValor');
    }

    function authoritativePedidoFieldsUnchanged() {
      return fieldUnchanged('lastAuthoritativeFunction');
    }

    function fieldNullOrMissing(data, field) {
      return !(data is map) || !data.keys().hasAny([field]) || data[field] == null;
    }

    function clearsFinalPricingFields() {
      return fieldNullOrMissing(request.resource.data, 'precoFinal')
        && fieldNullOrMissing(request.resource.data, 'preco')
        && fieldNullOrMissing(request.resource.data, 'commissionPlatform')
        && fieldNullOrMissing(request.resource.data, 'earningsProvider')
        && fieldNullOrMissing(request.resource.data, 'earningsTotal');
    }

    function validFinalPricingUpdate() {
      let nextEstado = pedidoEstado(request.resource.data);
      return finalPricingFieldsUnchanged()
        ? true
        : (clearsFinalPricingFields() &&
          (
            nextEstado == 'criado' ||
            nextEstado == 'aguarda_resposta_prestador' ||
            nextEstado == 'aguarda_resposta_cliente'
          ));
    }

    function validFinalProposalUpdate() {
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return finalProposalFieldsUnchanged()
        ? true
        : ((
          isPedidoPrestadorActorForUpdate()
          && currentEstado == 'em_andamento'
          && nextEstado == 'aguarda_confirmacao_valor'
          && fieldValueOrNull(request.resource.data, 'precoPropostoPrestador') is number
          && fieldValueOrNull(request.resource.data, 'precoPropostoPrestador') > 0
          && request.resource.data['statusConfirmacaoValor'] == 'pendente_cliente'
        )
        || (
          isPedidoClienteActor()
          && currentEstado == 'aguarda_confirmacao_valor'
          && nextEstado == 'concluido'
          && request.resource.data['statusConfirmacaoValor'] == 'confirmado_cliente'
        )
        || (
          isPedidoClienteActor()
          && currentEstado == 'aguarda_confirmacao_valor'
          && nextEstado == 'em_andamento'
          && request.resource.data['statusConfirmacaoValor'] == 'rejeitado_cliente'
        )
        || (
          fieldNullOrMissing(request.resource.data, 'precoPropostoPrestador')
          && (
            !request.resource.data.keys().hasAny(['statusConfirmacaoValor']) ||
            request.resource.data['statusConfirmacaoValor'] == 'nenhum'
          )
          && (
            nextEstado == 'criado' ||
            nextEstado == 'aguarda_resposta_prestador' ||
            nextEstado == 'aguarda_resposta_cliente'
          )
        ));
    }

    function validPedidoEconomicUpdate() {
      // Escritas cliente/Prestador nunca calculam nem confirmam economia. A
      // callable autoritativa usa Admin SDK e persiste os valores finais.
      return finalPricingFieldsUnchanged()
        && fieldUnchanged('precoPropostoPrestador');
    }

    function immutablePedidoIdentity() {
      return clienteIdFromData(request.resource.data) == clienteIdFromData(resource.data)
        && fieldValueOrNull(request.resource.data, 'clientId') ==
          fieldValueOrNull(resource.data, 'clientId')
        && fieldValueOrNull(request.resource.data, 'createdAt') ==
          fieldValueOrNull(resource.data, 'createdAt');
    }

    function immutablePedidoRequestDetails() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'servicoId',
        'servicoNome',
        'categoria',
        'titulo',
        'descricao',
        'modo',
        'agendadoPara',
        'tipoPreco',
        'tipoPagamento',
        'latitude',
        'longitude',
        'geo',
        'enderecoTexto',
        'anexos',
        'categoryApprovalRequired',
        'categoryRequirementId',
        'categoryRequirementName',
        'categoryRiskLevel',
        'isCustomService',
        'customServiceName',
        'customServiceDescription',
        'customServiceSearchTerms',
        'moderationStatus',
        'requestedProviderId'
      ]);
    }

    function validPedidoOpenAccept() {
      return false;
    }

    function hasOnlyPedidoClientManualInviteFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'prestadorId',
        'status',
        'estado',
        'updatedAt',
        'valorMinEstimadoPrestador',
        'valorMaxEstimadoPrestador',
        'mensagemPropostaPrestador',
        'statusProposta',
        'propostaExpiresAt',
        'statusConfirmacaoValor'
      ]);
    }

    function hasClearedPedidoQuote(statusProposta) {
      return fieldNullOrMissing(request.resource.data, 'valorMinEstimadoPrestador')
        && fieldNullOrMissing(request.resource.data, 'valorMaxEstimadoPrestador')
        && fieldNullOrMissing(request.resource.data, 'mensagemPropostaPrestador')
        && fieldNullOrMissing(request.resource.data, 'propostaExpiresAt')
        && fieldValueOrNull(request.resource.data, 'statusProposta') == statusProposta
        && fieldValueOrNull(request.resource.data, 'statusConfirmacaoValor') == 'nenhum';
    }

    function validPedidoClientManualInvite() {
      return isPedidoClienteActor()
        && pedidoEstado(resource.data) == 'criado'
        && pedidoEstado(request.resource.data) == 'aguarda_resposta_prestador'
        && fieldValueOrNull(resource.data, 'prestadorId') == null
        && fieldValueOrNull(request.resource.data, 'prestadorId') is string
        && hasOnlyPedidoClientManualInviteFields()
        && hasClearedPedidoQuote('nenhuma')
        && validPedidoUpdatedAt();
    }

    function hasOnlyPedidoProviderManualAcceptFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'estado',
        'updatedAt'
      ]);
    }

    function validPedidoProviderManualInviteAccept() {
      return false;
    }

    function validPedidoProviderQuoteProposal() {
      let minValue = fieldValueOrNull(request.resource.data, 'valorMinEstimadoPrestador');
      let maxValue = fieldValueOrNull(request.resource.data, 'valorMaxEstimadoPrestador');
      let message = fieldValueOrNull(request.resource.data, 'mensagemPropostaPrestador');
      let expiresAt = fieldValueOrNull(request.resource.data, 'propostaExpiresAt');
      return isPedidoPrestadorActorForUpdate()
        && prestadorMatchesPedido(resource.data)
        && hasValidPedidoEstado(request.resource.data)
        && isAllowedPrestadorPedidoTransition(
          pedidoEstado(resource.data),
          pedidoEstado(request.resource.data)
        )
        && pedidoEstado(request.resource.data) == 'aguarda_resposta_cliente'
        && fieldValueOrNull(request.resource.data, 'prestadorId') == uid()
        && minValue is number
        && maxValue is number
        && minValue > 0
        && maxValue >= minValue
        && (message == null || (message is string && message.size() <= 500))
        && expiresAt is timestamp
        && expiresAt > request.time
        && request.resource.data['statusProposta'] == 'pendente_cliente'
        && request.resource.data['statusConfirmacaoValor'] == 'nenhum'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'prestadorId',
          'valorMinEstimadoPrestador',
          'valorMaxEstimadoPrestador',
          'mensagemPropostaPrestador',
          'statusProposta',
          'propostaExpiresAt',
          'statusConfirmacaoValor',
          'status',
          'estado',
          'updatedAt'
        ])
        && validPedidoUpdatedAt();
    }

    function validPedidoProviderFinalProposal() {
      // O valor final e o respetivo histórico são gravados pela callable.
      return false;
    }

    function validPedidoProviderStartService() {
      return isPedidoPrestadorActorForUpdate()
        && hasValidPedidoEstado(request.resource.data)
        && pedidoEstado(resource.data) == 'aceito'
        && pedidoEstado(request.resource.data) == 'em_andamento'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'estado',
          'updatedAt'
        ])
        && validPedidoUpdatedAt()
        && fieldUnchanged('statusConfirmacaoValor');
    }

    function validPedidoClientAcceptQuote() {
      return isPedidoClienteActor()
        && hasValidPedidoEstado(request.resource.data)
        && pedidoEstado(resource.data) == 'aguarda_resposta_cliente'
        && pedidoEstado(request.resource.data) == 'aceito'
        && fieldValueOrNull(request.resource.data, 'prestadorId') ==
          fieldValueOrNull(resource.data, 'prestadorId')
        && request.resource.data['statusProposta'] == 'aceita_cliente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'estado',
          'updatedAt',
          'statusProposta'
        ])
        && validPedidoUpdatedAt()
        && fieldUnchanged('statusConfirmacaoValor');
    }

    function validPedidoClientFinalConfirmation() {
      return false;
    }

    function hasOnlyPedidoClientCancelFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'estado',
        'updatedAt',
        'canceladoPor',
        'motivoCancelamento',
        'motivoCancelamentoDetalhe'
      ]);
    }

    function validPedidoCancellationReason() {
      let reason = fieldValueOrNull(request.resource.data, 'motivoCancelamento');
      let detail = fieldValueOrNull(request.resource.data, 'motivoCancelamentoDetalhe');
      return reason is string
        && reason.size() > 0
        && reason.size() <= 160
        && (detail == null || (detail is string && detail.size() <= 500));
    }

    function validPedidoClientCancellation() {
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return isPedidoClienteActor()
        && nextEstado == 'cancelado'
        && isAllowedClientePedidoTransition(currentEstado, nextEstado)
        && hasOnlyPedidoClientCancelFields()
        && fieldValueOrNull(request.resource.data, 'canceladoPor') == 'cliente'
        && validPedidoCancellationReason()
        && validPedidoUpdatedAt()
        && fieldUnchanged('prestadorId');
    }

    function hasPedidoNoShowFieldChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'noShowReportedBy',
        'noShowReason',
        'noShowAt'
      ]);
    }

    function hasOnlyPedidoNoShowFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'noShowReportedBy',
        'noShowReason',
        'noShowAt',
        'updatedAt'
      ]);
    }

    function validNoShowReporterForActor() {
      let reporter = fieldValueOrNull(request.resource.data, 'noShowReportedBy');
      return (
          reporter == 'cliente' &&
          isPedidoClienteActor()
        )
        || (
          reporter == 'prestador' &&
          isPedidoPrestadorActorForUpdate()
        );
    }

    function validPedidoNoShowReport() {
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return hasOnlyPedidoNoShowFields()
        && currentEstado == nextEstado
        && currentEstado != 'cancelado'
        && currentEstado != 'concluido'
        && validNoShowReporterForActor()
        && fieldValueOrNull(request.resource.data, 'noShowReportedBy') in [
          'cliente',
          'prestador'
        ]
        && (
          fieldNullOrMissing(request.resource.data, 'noShowReason') ||
          (fieldValueOrNull(request.resource.data, 'noShowReason') is string
            && fieldValueOrNull(request.resource.data, 'noShowReason').size() <= 500)
        )
        && fieldValueOrNull(request.resource.data, 'noShowAt') is timestamp
        && fieldValueOrNull(request.resource.data, 'noShowAt') == request.time
        && validPedidoUpdatedAt()
        && fieldUnchanged('statusConfirmacaoValor')
        && fieldUnchanged('prestadorId');
    }

    function validPedidoClientRejectQuote() {
      return isPedidoClienteActor()
        && pedidoEstado(resource.data) == 'aguarda_resposta_cliente'
        && pedidoEstado(request.resource.data) == 'criado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'prestadorId',
          'valorMinEstimadoPrestador',
          'valorMaxEstimadoPrestador',
          'mensagemPropostaPrestador',
          'statusProposta',
          'propostaExpiresAt',
          'statusConfirmacaoValor',
          'status',
          'estado',
          'updatedAt'
        ])
        && fieldValueOrNull(request.resource.data, 'prestadorId') == null
        && hasClearedPedidoQuote('rejeitada_cliente')
        && validPedidoUpdatedAt();
    }

    function validPedidoClientRejectFinalValue() {
      return isPedidoClienteActor()
        && pedidoEstado(resource.data) == 'aguarda_confirmacao_valor'
        && pedidoEstado(request.resource.data) == 'em_andamento'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'estado',
          'updatedAt',
          'statusConfirmacaoValor'
        ])
        && fieldValueOrNull(request.resource.data, 'statusConfirmacaoValor') ==
          'rejeitado_cliente'
        && validPedidoUpdatedAt()
        && fieldUnchanged('prestadorId');
    }

    function validPedidoProviderWithdrawal() {
      let currentEstado = pedidoEstado(resource.data);
      return isPedidoPrestadorActorForUpdate()
        && currentEstado in [
          'aguarda_resposta_prestador',
          'aguarda_resposta_cliente',
          'aceito'
        ]
        && pedidoEstado(request.resource.data) == 'criado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'prestadorId',
          'valorMinEstimadoPrestador',
          'valorMaxEstimadoPrestador',
          'mensagemPropostaPrestador',
          'statusProposta',
          'propostaExpiresAt',
          'statusConfirmacaoValor',
          'status',
          'estado',
          'updatedAt',
          'canceladoPor',
          'motivoCancelamento',
          'motivoCancelamentoDetalhe'
        ])
        && fieldValueOrNull(request.resource.data, 'prestadorId') == null
        && hasClearedPedidoQuote('nenhuma')
        && fieldNullOrMissing(request.resource.data, 'canceladoPor')
        && fieldNullOrMissing(request.resource.data, 'motivoCancelamento')
        && fieldNullOrMissing(request.resource.data, 'motivoCancelamentoDetalhe')
        && validPedidoUpdatedAt();
    }

    function validPedidoProviderCancellation() {
      let currentEstado = pedidoEstado(resource.data);
      return isPedidoPrestadorActorForUpdate()
        && currentEstado in ['em_andamento', 'aguarda_confirmacao_valor']
        && pedidoEstado(request.resource.data) == 'cancelado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'estado',
          'updatedAt',
          'canceladoPor',
          'motivoCancelamento',
          'motivoCancelamentoDetalhe'
        ])
        && fieldValueOrNull(request.resource.data, 'canceladoPor') == 'prestador'
        && validPedidoCancellationReason()
        && validPedidoUpdatedAt()
        && fieldUnchanged('prestadorId');
    }

    function validPedidoGenericUpdate() {
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return currentEstado == 'aguarda_resposta_cliente' && nextEstado == 'criado'
        ? validPedidoClientRejectQuote()
        : (currentEstado == 'aguarda_confirmacao_valor' && nextEstado == 'em_andamento'
          ? validPedidoClientRejectFinalValue()
          : (nextEstado == 'criado'
            ? validPedidoProviderWithdrawal()
            : (nextEstado == 'cancelado'
              ? validPedidoProviderCancellation()
              : false)));
    }

    function validPedidoUpdate() {
      let currentEstado = pedidoEstado(resource.data);
      let nextEstado = pedidoEstado(request.resource.data);
      return !hasValidPedidoEstado(request.resource.data)
        ? false
        : (
            // Cada ramo permitido abaixo usa affectedKeys().hasOnly(...).
            // Logo pagamento, economia, histórico, conclusão, identidade e
            // qualquer campo futuro ficam server-only por defeito.
            hasPedidoNoShowFieldChange()
              ? (
                hasOnlyPedidoNoShowFields()
                  ? validPedidoNoShowReport()
                  : false
              )
              : (
                currentEstado == 'criado' && nextEstado == 'aceito'
                  ? validPedidoOpenAccept()
                  : (
                    currentEstado == 'criado' && nextEstado == 'aguarda_resposta_prestador'
                      ? validPedidoClientManualInvite()
                      : (
                        currentEstado == 'aguarda_resposta_prestador' && nextEstado == 'aceito'
                          ? validPedidoProviderManualInviteAccept()
                          : (
                            nextEstado == 'aguarda_resposta_cliente'
                              ? validPedidoProviderQuoteProposal()
                              : (
                                currentEstado == 'em_andamento' && nextEstado == 'aguarda_confirmacao_valor'
                                  ? validPedidoProviderFinalProposal()
                                  : (
                                    currentEstado == 'aguarda_resposta_cliente' && nextEstado == 'aceito'
                                      ? validPedidoClientAcceptQuote()
                                      : (
                                        currentEstado == 'aceito' && nextEstado == 'em_andamento'
                                          ? validPedidoProviderStartService()
                                          : (
                                            currentEstado == 'aguarda_confirmacao_valor' && nextEstado == 'concluido'
                                              ? validPedidoClientFinalConfirmation()
                                              : (
                                                isPedidoClienteActor() && nextEstado == 'cancelado'
                                                  ? validPedidoClientCancellation()
                                                  : validPedidoGenericUpdate()
                                              )
                                          )
                                      )
                                  )
                              )
                          )
                      )
                  )
              )
        );
    }

    // -------------------------
    // Chat helpers
    // -------------------------
    function isChatParticipantByData(chatData) {
      return signedIn() && chatData is map
        ? (
          clienteIdFromData(chatData) == uid() ||
          (chatData.keys().hasAny(['prestadorId']) &&
            chatData['prestadorId'] == uid())
        )
        : false;
    }

    function chatSnap(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    // Ãštil para subcoleÃ§Ãµes (messages)
    function isChatParticipant(chatId) {
      let c = chatSnap(chatId).data;
      return isChatParticipantByData(c);
    }

    function hasTextField(data) {
      return data is map
        && (
          (data.keys().hasAny(['text']) && data['text'] is string) ||
          (data.keys().hasAny(['texto']) && data['texto'] is string) ||
          (data.keys().hasAny(['message']) && data['message'] is string) ||
          (data.keys().hasAny(['conteudo']) && data['conteudo'] is string)
        );
    }

    function hasMediaField(data, chatId) {
      return data is map
        && data.keys().hasAny(['mediaPath'])
        && data['mediaPath'] is string
        && data['mediaPath'].size() > 0
        && data['mediaPath'].size() <= 500
        && data['mediaPath'].matches(
          '^chats/' + chatId + '/(images|files|audio)/[^/]+$'
        )
        && !data.keys().hasAny(['mediaUrl', 'fileUrl', 'url']);
    }

    function hasValidMessageType(data) {
      return data is map
        && (
          !data.keys().hasAny(['type']) ||
          data['type'] in ['text', 'image', 'audio', 'file', 'location', 'sticker', 'gif']
        );
    }

    function isPedidoClientById(pedidoId) {
      return signedIn()
        && clienteIdFromData(pedidoSnap(pedidoId).data) == uid();
    }

    function isPedidoProviderById(pedidoId) {
      let pedido = pedidoSnap(pedidoId).data;
      return providerHasFullPedidoAccess(pedido);
    }

    function validChatMessageCreate(chatId) {
      let data = request.resource.data;
      let type = data.keys().hasAny(['type']) ? data['type'] : 'text';
      return hasVerifiedPhone()
        && data.keys().hasOnly([
          'pedidoId',
          'type',
          'text',
          'texto',
          'message',
          'conteudo',
          'replyToId',
          'replyToText',
          'senderId',
          'senderRole',
          'createdAt',
          'seenByCliente',
          'seenByPrestador',
          'deliveredToCliente',
          'deliveredToPrestador',
          'mediaPath',
          'fileName',
          'fileSize',
          'mimeType',
          'durationMs',
          'locationLat',
          'locationLng',
          'latitude',
          'longitude',
        ])
        && data.keys().hasAll([
          'pedidoId',
          'type',
          'senderId',
          'senderRole',
          'createdAt',
        ])
        && data['pedidoId'] == chatId
        && data['senderId'] == uid()
        && data['senderRole'] in ['cliente', 'prestador']
        && (
          (data['senderRole'] == 'cliente' && isPedidoClientById(chatId))
          || (data['senderRole'] == 'prestador' && isPedidoProviderById(chatId))
        )
        && data['createdAt'] is timestamp
        && data['createdAt'] == request.time
        && hasValidMessageType(data)
        && validOptionalString(data, 'text', 2000)
        && validOptionalString(data, 'texto', 2000)
        && validOptionalString(data, 'message', 2000)
        && validOptionalString(data, 'conteudo', 2000)
        && validOptionalString(data, 'replyToId', 128)
        && validOptionalString(data, 'replyToText', 500)
        && validOptionalString(data, 'fileName', 255)
        && validOptionalString(data, 'mimeType', 120)
        && (!data.keys().hasAny(['fileSize'])
          || (data['fileSize'] is int && data['fileSize'] > 0
            && data['fileSize'] <= 20 * 1024 * 1024))
        && (!data.keys().hasAny(['durationMs'])
          || (data['durationMs'] is int && data['durationMs'] >= 0
            && data['durationMs'] <= 24 * 60 * 60 * 1000))
        && (
          type in ['image', 'audio', 'file', 'sticker', 'gif']
            ? hasMediaField(data, chatId)
            : hasTextField(data)
        )
        && (type == 'location'
          ? (data.keys().hasAll(['locationLat', 'locationLng'])
            && data['locationLat'] is number
            && data['locationLat'] >= -90
            && data['locationLat'] <= 90
            && data['locationLng'] is number
            && data['locationLng'] >= -180
            && data['locationLng'] <= 180)
          : !data.keys().hasAny(['locationLat', 'locationLng', 'latitude', 'longitude']));
    }

    function validChatMessageUpdate(chatId) {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      return hasVerifiedPhone()
        && isPedidoParticipantById(chatId)
        && affected.hasOnly([
          'seenByCliente',
          'seenByPrestador',
          'deliveredToCliente',
          'deliveredToPrestador',
          'starredBy',
          'reactions',
          'isDeleted',
          'isEdited',
          'editedAt',
          'updatedAt',
          'text',
        ])
        && (!affected.hasAny(['seenByCliente', 'deliveredToCliente'])
          || isPedidoClientById(chatId))
        && (!affected.hasAny(['seenByPrestador', 'deliveredToPrestador'])
          || isPedidoProviderById(chatId))
        && (!affected.hasAny(['text', 'isDeleted', 'isEdited', 'editedAt', 'updatedAt'])
          || resource.data['senderId'] == uid())
        && (!affected.hasAny(['text'])
          || (data['text'] is string && data['text'].size() <= 2000))
        && (!affected.hasAny(['isDeleted']) || data['isDeleted'] == true)
        && (!affected.hasAny(['isEdited']) || data['isEdited'] == true)
        && (!affected.hasAny(['editedAt'])
          || (data['editedAt'] is timestamp && data['editedAt'] == request.time))
        && (!affected.hasAny(['updatedAt'])
          || (data['updatedAt'] is timestamp && data['updatedAt'] == request.time))
        && (!affected.hasAny(['starredBy'])
          || (data['starredBy'] is list && data['starredBy'].size() <= 2))
        && (!affected.hasAny(['reactions'])
          || (data['reactions'] is map && data['reactions'].size() <= 20));
    }

    function validChatMetaCreate(chatId) {
      let data = request.resource.data;
      let pedido = pedidoSnap(chatId).data;
      return hasVerifiedPhone()
        && pedido is map
        && isPedidoParticipantByData(pedido)
        && data.keys().hasOnly([
          'pedidoId',
          'clienteId',
          'prestadorId',
          'pedidoTitulo',
          'createdAt',
          'updatedAt',
          'lastMessageAt',
          'lastMessage',
          'lastSenderRole',
          'hasUnreadCliente',
          'hasUnreadPrestador',
          'unreadByCliente',
          'unreadByPrestador',
          'favoritedBy',
        ])
        && data.keys().hasAll([
          'pedidoId',
          'clienteId',
          'prestadorId',
          'createdAt',
          'updatedAt',
        ])
        && data['pedidoId'] == chatId
        && data['clienteId'] == clienteIdFromData(pedido)
        && pedido.keys().hasAny(['prestadorId'])
        && data['prestadorId'] == pedido['prestadorId']
        && data['createdAt'] is timestamp
        && data['createdAt'] == request.time
        && data['updatedAt'] is timestamp
        && data['updatedAt'] == request.time
        && validOptionalString(data, 'pedidoTitulo', 180)
        && validOptionalString(data, 'lastMessage', 500)
        && validOptionalString(data, 'lastSenderRole', 20);
    }

    function validChatMetaUpdate(chatId) {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      return hasVerifiedPhone()
        && isPedidoParticipantById(chatId)
        && affected.hasOnly([
          'pedidoTitulo',
          'updatedAt',
          'lastMessageAt',
          'lastMessage',
          'lastSenderRole',
          'hasUnreadCliente',
          'hasUnreadPrestador',
          'unreadByCliente',
          'unreadByPrestador',
          'favoritedBy',
        ])
        && validOptionalString(data, 'pedidoTitulo', 180)
        && validOptionalString(data, 'lastMessage', 500)
        && validOptionalString(data, 'lastSenderRole', 20)
        && (!affected.hasAny(['updatedAt'])
          || (data['updatedAt'] is timestamp && data['updatedAt'] == request.time))
        && (!affected.hasAny(['lastMessageAt']) || data['lastMessageAt'] is timestamp)
        && (!affected.hasAny(['hasUnreadCliente']) || data['hasUnreadCliente'] is bool)
        && (!affected.hasAny(['hasUnreadPrestador']) || data['hasUnreadPrestador'] is bool)
        && (!affected.hasAny(['unreadByCliente'])
          || (data['unreadByCliente'] is int && data['unreadByCliente'] >= 0))
        && (!affected.hasAny(['unreadByPrestador'])
          || (data['unreadByPrestador'] is int && data['unreadByPrestador'] >= 0))
        && (!affected.hasAny(['favoritedBy'])
          || (data['favoritedBy'] is list && data['favoritedBy'].size() <= 2));
    }

    // -------------------------
    // Call helpers
    // -------------------------
    function callSnap(callId) {
      return get(/databases/$(database)/documents/calls/$(callId));
    }

    function isCallParticipantByData(callData) {
      return signedIn() && callData is map
        ? (
          (callData.keys().hasAny(['callerId']) && callData['callerId'] == uid()) ||
          (callData.keys().hasAny(['calleeId']) && callData['calleeId'] == uid())
        )
        : false;
    }

    function isCallParticipantById(callId) {
      let c = callSnap(callId).data;
      return isCallParticipantByData(c);
    }

    // -------------------------
    // USERS
    // -------------------------
    match /users_private/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if validUserPrivateOwnerCreate(userId) || isAdmin();
      allow update: if validUserPrivateOwnerUpdate(userId) || isAdmin();
      allow delete: if isAdmin() || devMode();

      match /fcmTokens/{tokenId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, update: if isSelf(userId) || isAdmin();
        allow create: if false; // sÃ³ backend/admin
        allow delete: if isAdmin() || devMode();
      }
    }

    match /users_private/{userId}/favorites/{prestadorId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /users_private/{userId}/blockedUsers/{blockedUid} {
      allow read: if isSelf(userId) || canModerate();
      allow create: if validBlockedUserCreate(userId, blockedUid);
      allow update: if false;
      allow delete: if isSelf(userId) || canModerate();
    }

    match /public_profiles/{profileId} {
      allow read: if true;
      allow create, update: if validPublicProfileOwnerWrite(profileId)
        || isAdmin();
      allow delete: if isAdmin() || devMode();
    }

    // -------------------------
    // PRESTADORES
    // -------------------------
    match /provider_public_legacy_rule_disabled/{prestadorId} {
      allow read: if true; // perfis precisam ser visíveis
      allow create: if isAdmin() || validPrestadorOwnerCreate(prestadorId);
      
      // Owner can update own profile, but cannot self-edit rating aggregates.
      // Rating aggregates are updated by trusted backend/admin only.
      allow update: if isAdmin() || validPrestadorOwnerUpdate(prestadorId);

      allow delete: if isAdmin() || devMode();

    }

    match /provider_public/{prestadorId} {
      allow read: if isSelf(prestadorId)
        || isAdmin()
        || (resource.data is map
          && resource.data.keys().hasAny(['isSearchable'])
          && resource.data['isSearchable'] == true);
      allow create: if isAdmin() || validPrestadorOwnerCreate(prestadorId);
      allow update: if isAdmin() || validPrestadorOwnerUpdate(prestadorId);
      allow delete: if isAdmin() || devMode();
    }

    match /provider_private/{prestadorId} {
      allow read: if isSelf(prestadorId) || isAdmin();
      allow create, update, delete: if isAdmin() || devMode();

      match /categoryApprovals/{categoryId} {
        allow read: if isSelf(prestadorId) || isAdmin();
        allow create, update: if (isAdmin() || devMode())
          && validProviderCategoryApprovalData(
            request.resource.data,
            prestadorId,
            categoryId,
          );
        allow delete: if isAdmin() || devMode();
      }

      match /financialTransactions/{transactionId} {
        allow read: if isSelf(prestadorId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /provider_dispatch_private/{prestadorId} {
      allow read: if isSelf(prestadorId)
        || isAdmin();
      allow create: if isAdmin()
        || validProviderDispatchOwnerCreate(prestadorId);
      allow update: if isAdmin()
        || validProviderDispatchOwnerUpdate(prestadorId);
      allow delete: if isAdmin() || devMode();
    }

    match /kyc_submissions/{prestadorId} {
      allow read: if isSelf(prestadorId) || isAdmin();
      allow create, update, delete: if isAdmin() || devMode();
    }

    match /kyc_upload_grants/{prestadorId} {
      allow read, write: if isAdmin() || devMode();
    }

    // Migration-only mixed documents are no longer client-readable.
    match /users/{legacyUserId} {
      allow read, write: if false;
    }

    match /prestadores/{legacyProviderId} {
      allow read, write: if false;
    }

    // -------------------------
    // PUBLIC HANDLES
    // -------------------------
    match /handles/{handleId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // -------------------------
    // SENSITIVE CATEGORY APPROVALS
    // -------------------------
    match /categoryRequirements/{categoryId} {
      allow read: if true;
      allow create, update: if (isAdmin() || devMode())
        && validCategoryRequirementData(request.resource.data)
        && request.resource.data['categoryId'] == categoryId;
      allow delete: if isAdmin() || devMode();
    }

    match /sensitiveCategoryRequests/{requestId} {
      allow read: if (signedIn() && resource.data['providerId'] == uid())
        || isAdmin()
        || devMode();
      allow create, update: if (isAdmin() || devMode())
        && validSensitiveCategoryRequestData(request.resource.data);
      allow delete: if isAdmin() || devMode();
    }

    // -------------------------
    // AVALIACOES
    // -------------------------
    match /avaliacoes/{avaliacaoId} {
      allow read: if isPedidoParticipantById(resource.data['pedidoId'])
        || isAdmin();

      allow create: if validAvaliacaoCreate(avaliacaoId);

      allow update, delete: if isAdmin() || devMode();
    }

    // -------------------------
    // SERVICOS (catÃ¡logo)
    // -------------------------
    // -------------------------
    // TRUST & SAFETY REPORTS
    // -------------------------
    match /reports/{reportId} {
      allow read: if canModerate()
        || (signedIn()
          && resource.data is map
          && resource.data.keys().hasAny(['reporterId'])
          && resource.data['reporterId'] == uid());
      allow create: if validReportCreate();
      allow update, delete: if canModerate();
    }

    match /servicos/{servicoId} {
      allow read: if true;
      allow create, update, delete: if devMode() || isAdmin();
    }

    // -------------------------
    // STORIES
    // -------------------------
    match /stories/{storyId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin() || devMode();
    }

    // -------------------------
    // PEDIDOS
    // -------------------------
    match /pedidos/{pedidoId} {

      // Criação passa exclusivamente pela Function autoritativa.
      allow create: if false;

      // Cliente ativo lê o próprio pedido. Prestador ativo só recebe o
      // documento integral depois do grant autoritativo criado na aceitação.
      // Descoberta e convites usam exclusivamente pedido_dispatch sanitizado.
      allow get: if devMode()
        ? true
        : (isActivePilotPedidoParticipantByData(resource.data) || isAdmin());
      allow list: if devMode()
        ? true
        : (isActivePilotPedidoListParticipant(resource.data) || isAdmin());

      // Toda transição de Cliente/Prestador passa por callable autoritativa.
      // O Admin SDK das Functions ignora Rules; clientes com claim de admin
      // mantêm acesso operacional explícito para intervenção auditada.
      allow update: if isAdmin();

      allow delete: if isAdmin() || devMode();
    }

    match /pedido_dispatch/{pedidoId} {
      allow get: if (
          providerMayReceiveDispatch()
          && isActivePilotParticipantForRole('prestador')
          && canReadPedidoDispatch(resource.data)
        ) || isAdmin();
      allow list: if (
          providerMayReceiveDispatch()
          && isActivePilotParticipantForRole('prestador')
          && canListPedidoDispatch(resource.data)
        ) || isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------
    // CHATS (chatId == pedidoId)
    // -------------------------
    match /chats/{chatId} {

      // âœ… GET (doc especÃ­fico): participante via pedido OU via chat
      allow get: if isActivePilotPedidoParticipantById(chatId);

      // âœ… LIST (queries): usa sÃ³ os campos do prÃ³prio chat
      allow list: if isActivePilotPedidoParticipantById(chatId);

      // Criar meta do chat
      allow create: if isActivePilotPedidoParticipantById(chatId)
        && pedidoAllowsParticipantWrites(pedidoSnap(chatId).data)
        && validChatMetaCreate(chatId);

      // Update: participante ativo comprovado pelo pedido
      allow update: if isActivePilotPedidoParticipantById(chatId)
        && pedidoAllowsParticipantWrites(pedidoSnap(chatId).data)
        && validChatMetaUpdate(chatId);

      allow delete: if isAdmin() || devMode();

      match /messages/{messageId} {
        allow get, list: if isActivePilotPedidoParticipantById(chatId);

        // Criar mensagem: participante e senderId tem de ser o prÃ³prio
        allow create: if isActivePilotPedidoParticipantById(chatId)
          && pedidoAllowsParticipantWrites(pedidoSnap(chatId).data)
          && validChatMessageCreate(chatId);

        // delivered/seen/etc.
        allow update: if isActivePilotPedidoParticipantById(chatId)
          && pedidoAllowsParticipantWrites(pedidoSnap(chatId).data)
          && validChatMessageUpdate(chatId);

        allow delete: if isAdmin() || devMode();
      }

      match /typing/{userId} {
        allow read: if isActivePilotPedidoParticipantById(chatId);
        allow create, update, delete: if isActivePilotPedidoParticipantById(chatId)
          && pedidoAllowsParticipantWrites(pedidoSnap(chatId).data)
          && isSelf(userId);
      }
    }

    // -------------------------
    // CALLS (audio/video)
    // -------------------------
    match /calls/{callId} {
      allow create, get, list, update: if false;
      allow delete: if isAdmin() || devMode();

      match /offerCandidates/{candidateId} {
        allow read, write: if false;
      }

      match /answerCandidates/{candidateId} {
        allow read, write: if false;
      }
    }

    // -------------------------
    // SUPPORT TICKETS
    // -------------------------
    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || devMode()
        || (signedIn() && resource.data['uid'] == uid());
      allow create, update, delete: if isAdmin() || devMode();
    }

    // Criacao, cancelamento e execucao sao exclusivamente server-side.
    match /account_deletion_requests/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /legal_consent_audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /account_deletion_audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pilot_participants/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /provider_opportunities/{opportunityId} {
      allow get: if isAdmin()
        || (isActivePilotParticipantForRole('prestador')
          && providerMayGetOpportunity(resource.data));
      allow list: if isAdmin()
        || (isActivePilotParticipantForRole('prestador')
          && request.query.limit != null
          && request.query.limit <= 50
          && providerMayListOpportunity(resource.data));
      allow create, update, delete: if false;
    }

    match /pilot_metrics_daily/{metricId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------
    // PAYMENTS (admin/backoffice read-only)
    // -------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin() || devMode();
      allow create, update, delete: if false; // only backend/admin SDK
    }

    // -------------------------
    // PAYMENT LEDGER (immutable)
    // -------------------------
    match /payment_ledger/{entryId} {
      allow read: if isAdmin() || devMode();
      allow create, update, delete: if false; // only backend/admin SDK
    }

    match /commission_payments/{receiptId} {
      allow read: if isAdmin() || devMode();
      allow create, update, delete: if false;
    }

    // -------------------------
    // SUBSCRIPTIONS (owner + admin read-only)
    // -------------------------
    match /subscriptions/{subUid} {
      allow read: if (signedIn() && uid() == subUid) || isAdmin() || devMode();
      allow create, update, delete: if false; // only backend/admin SDK
    }

    // -------------------------
    // REMINDER LOGS (scheduler dedup)
    // -------------------------
    match /scheduled_reminder_logs/{logId} {
      allow read: if isAdmin() || devMode();
      allow create, update, delete: if false; // only backend/admin SDK
    }

    // -------------------------
    // Default deny
    // -------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
